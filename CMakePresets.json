{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw-base",
      "hidden": true,
      "generator": "MinGW Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-gcc.cmake",
      "environment": {
        "PATH": "$env{HAVREMOTE_MINGW_ROOT}/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "HAVREMOTE_MINGW_ROOT": "$env{HAVREMOTE_MINGW_ROOT}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HAVREMOTE_BUILD_TESTS": "ON",
        "HAVREMOTE_BUILD_INTEGRATION_TESTS": "OFF"
      },
      "warnings": {
        "dev": true,
        "deprecated": true,
        "uninitialized": false,
        "unusedCli": true,
        "systemVars": false
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW GCC Debug",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build/mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW GCC Release",
      "inherits": "mingw-base",
      "binaryDir": "${sourceDir}/build/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc",
      "displayName": "Visual Studio 2022 x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "HAVREMOTE_BUILD_TESTS": "ON",
        "HAVREMOTE_BUILD_INTEGRATION_TESTS": "OFF"
      }
    },
    {
      "name": "linux-desktop",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HAVREMOTE_BUILD_APP": "ON",
        "HAVREMOTE_BUILD_TESTS": "ON",
        "HAVREMOTE_BUILD_INTEGRATION_TESTS": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Desktop Debug",
      "inherits": "linux-desktop",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Desktop Release",
      "inherits": "linux-desktop",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-sanitizers",
      "displayName": "Linux headless ASan/UBSan",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-sanitizers",
      "cacheVariables": {
        "HAVREMOTE_BUILD_APP": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
        "HAVREMOTE_BUILD_TESTS": "ON",
        "HAVREMOTE_BUILD_INTEGRATION_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release"
    },
    {
      "name": "mingw-release-symbols",
      "configurePreset": "mingw-release",
      "targets": ["package-symbols"]
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-sanitizers",
      "configurePreset": "linux-sanitizers",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "mingw-release",
      "configurePreset": "mingw-release",
      "generators": ["ZIP"]
    }
  ]
}
