# SPDX-License-Identifier: MIT

cmake_minimum_required(VERSION 4.0)
set(_expected_root "@FIXTURE_EXPECTED_ROOT@")
cmake_path(CONVERT "$ENV{HAVREMOTE_MINGW_ROOT}" TO_CMAKE_PATH_LIST _actual_root NORMALIZE)
cmake_path(CONVERT "${_expected_root}" TO_CMAKE_PATH_LIST _expected_root NORMALIZE)
if(NOT _actual_root STREQUAL _expected_root)
  message(FATAL_ERROR "${STAGE}: unexpected MinGW environment: ${_actual_root}")
endif()
if(NOT "@FIXTURE_CACHED_ROOT@" STREQUAL _expected_root)
  message(FATAL_ERROR "${STAGE}: the MinGW cache entry does not match the selected root")
endif()
if(NOT "$ENV{HAVREMOTE_HELPER_MARKER}" STREQUAL "@FIXTURE_EXPECTED_MARKER@")
  message(FATAL_ERROR "${STAGE}: preset environment was not inherited")
endif()
string(REPLACE ";" "\n" _path "$ENV{PATH}")
string(REGEX MATCH "^[^\n]*" _first_path "${_path}")
cmake_path(CONVERT "${_first_path}" TO_CMAKE_PATH_LIST _first_path NORMALIZE)
if(NOT _first_path STREQUAL "${_expected_root}/bin")
  message(FATAL_ERROR "${STAGE}: the selected MinGW bin directory is not first on PATH")
endif()
if(NOT EXISTS "@FIXTURE_BINARY_DIR@/stage.cmake")
  message(FATAL_ERROR "${STAGE}: unexpected binary directory")
endif()
file(APPEND "@FIXTURE_SOURCE_DIR@/stages.txt" "${STAGE}\n")
if("$ENV{HAVREMOTE_HELPER_FAIL_STAGE}" STREQUAL STAGE)
  message(FATAL_ERROR "Requested fixture failure at ${STAGE}")
endif()
